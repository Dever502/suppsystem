# Required Telegram settings. SUPPORT_GROUP_ID must be a private Forum supergroup where
# the bot is an administrator with permission to manage topics.
SUPPORT_BOT_TOKEN=
SUPPORT_GROUP_ID=
# Comma-separated numeric Telegram IDs. At least one is required unless API_ENABLED=true.
# Every listed admin can use all bot commands.
ADMIN_TELEGRAM_IDS=

# SQLite is the default storage backend. Runtime files are stored under DATA_DIR.
DATA_DIR=./data
# DATABASE_URL is optional; when omitted, SQLite uses DATA_DIR/support.db.
# SQLite override example:
# DATABASE_URL=sqlite+aiosqlite:///./data/support.db
# MIGRATION_DATABASE_URL defaults to DATABASE_URL. Production PostgreSQL Compose overrides both
# with separate least-privilege roles.
# MIGRATION_DATABASE_URL=
# Production PostgreSQL Compose runs migrations in a one-shot service and forces this to false.
MIGRATIONS_AT_STARTUP=true
# Required only for PostgreSQL mode: three distinct URL-safe random passwords,
# each at least 16 characters long.
# Roles are fixed internally: postgres, resolvate_migrator and resolvate_runtime.
POSTGRES_DB=resolvate
POSTGRES_ADMIN_PASSWORD=
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=

# Runtime tuning
LOG_LEVEL=INFO
# Per-user message limits shared by Telegram and Web. Text and photo each count once.
USER_MESSAGES_PER_MINUTE=30
USER_MESSAGES_PER_HOUR=200
# Authenticated requests allowed per API token during a fixed 60-second window.
API_REQUESTS_PER_MINUTE=6000

# Optional operator REST API. Compose exposes it only on 127.0.0.1:8080;
# use an HTTPS reverse proxy for external access.
API_ENABLED=false
# Enabled API tokens must contain at least 32 non-placeholder characters.
API_ADMIN_TOKEN=
# Unsafe: disables built-in API auth only with an advanced loopback bind.
API_UNSAFE_DISABLE_AUTH=false

# Optional server-to-server support API for a website backend. It shares the internal API
# endpoint, but uses a separate credential, request quota and route namespace.
WEB_API_ENABLED=false
# Must differ from API_ADMIN_TOKEN and contain at least 32 non-placeholder characters.
WEB_API_TOKEN=
# external_id (recommended): stable external_user_id identifies a client; email is mutable.
# email: normalized email identifies a client. Do not change after accepting Web messages.
WEB_IDENTITY_MODE=external_id

# Optional supported Remnawave 2.8.x integration. Remnawave remains the source of truth.
REMNAWAVE_ENABLED=false
# External integration URLs require HTTPS; HTTP is accepted only for localhost/loopback dev.
# Enabled Remnawave and webhook secrets must contain at least 32 non-placeholder characters.
# Panel origin without /api, for example https://panel.example.com.
REMNAWAVE_BASE_URL=
REMNAWAVE_API_TOKEN=
# Controls direct Telegram delivery for /revokelink. A webhook event is always queued.
# true: Telegram + webhook event; false: webhook event only.
REMNAWAVE_REVOKE_LINK_TELEGRAM_NOTIFICATION=true
# Enables actual at-least-once webhook delivery to your product backend.
NOTIFICATION_WEBHOOK_ENABLED=false
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
