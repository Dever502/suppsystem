# Required Telegram settings
SUPPORT_BOT_TOKEN=
SUPPORT_GROUP_ID=

# Full admins and operators currently have the same full application permissions.
# The separate roles allow operator permissions to be restricted in future releases.
FULL_ADMIN_TELEGRAM_IDS=
OPERATOR_TELEGRAM_IDS=
# Read-only operators can use /info and /subinfo, but cannot reply or change state.
READONLY_OPERATOR_TELEGRAM_IDS=
# Deprecated alias for FULL_ADMIN_TELEGRAM_IDS. Keep empty in new installations.
ADMIN_TELEGRAM_IDS=

# SQLite is the default storage backend. Runtime files are stored under DATA_DIR.
DATA_DIR=./data
# DATABASE_URL is optional; when omitted, SQLite uses DATA_DIR/support.db.
# SQLite override example:
# DATABASE_URL=sqlite+aiosqlite:///./data/support.db
# MIGRATION_DATABASE_URL defaults to DATABASE_URL. Production PostgreSQL Compose overrides both
# with separate least-privilege roles.
# MIGRATION_DATABASE_URL=
# Production PostgreSQL Compose runs migrations in a one-shot service and forces this to false.
MIGRATIONS_AT_STARTUP=true
# PostgreSQL bootstrap, migration and runtime credentials. Use URL-safe random passwords.
POSTGRES_DB=supportbot
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
POSTGRES_MIGRATION_USER=supportbot_migrator
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_RUNTIME_USER=supportbot_runtime
POSTGRES_RUNTIME_PASSWORD=

# Runtime tuning
LOG_LEVEL=INFO
DELIVERY_POLL_INTERVAL_SECONDS=1
TELEGRAM_MIN_REQUEST_INTERVAL_SECONDS=0.05
DELIVERY_MAX_ATTEMPTS=8

# Optional operator REST API. Keep the bind address local unless a reverse proxy handles TLS.
API_ENABLED=false
API_HOST=0.0.0.0
API_PUBLISH_HOST=127.0.0.1
API_PORT=8080
# Enabled API tokens must contain at least 32 non-placeholder characters.
API_ADMIN_TOKEN=
# Unsafe: disables built-in API auth only when API_HOST is loopback.
API_UNSAFE_DISABLE_AUTH=false
# Audit actor used by the initial static-token API; do not use a real Telegram ID.
API_OPERATOR_TELEGRAM_ID=0
# Per-client-IP request limit. This is process-local and intended for single-instance deployments.
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
# Failed authentication attempts allowed per client IP and window.
API_AUTH_FAILURE_LIMIT=10
API_AUTH_FAILURE_WINDOW_SECONDS=60
# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For/X-Real-IP.
API_TRUSTED_PROXY_IPS=


# Experimental in v0.1.0 and disabled by default. Remnawave remains source of truth when enabled.
REMNAWAVE_ENABLED=false
# External integration URLs require HTTPS; HTTP is accepted only for localhost/loopback dev.
# Enabled Remnawave and webhook secrets must contain at least 32 non-placeholder characters.
REMNAWAVE_BASE_URL=
REMNAWAVE_API_TOKEN=
REMNAWAVE_TIMEOUT_SECONDS=5
# Delay before checking the result of a timed-out mutation. Use 0 only in tests.
REMNAWAVE_RECONCILE_DELAY_SECONDS=10
# Experimental in v0.1.0 and disabled by default. Delivers events to your product backend.
NOTIFICATION_WEBHOOK_ENABLED=false
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=5
NOTIFICATION_WEBHOOK_MAX_ATTEMPTS=8
NOTIFICATION_WEBHOOK_POLL_INTERVAL_SECONDS=1
