# Example HTTPS reverse proxy for the optional Operator and Web Support APIs.
# Replace support.example.invalid and certificate paths before use.
# Keep the suppsystem API published on loopback:
#   API_ENABLED=true
#   API_PUBLISH_HOST=127.0.0.1
#   API_PORT=8080

server {
    listen 80;
    server_name support.example.invalid;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name support.example.invalid;

    ssl_certificate /etc/letsencrypt/live/support.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/support.example.invalid/privkey.pem;

    client_max_body_size 11m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # This is the public trust boundary: discard any client-supplied chain.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        # Set API_TRUSTED_PROXY_IPS to this proxy address in suppsystem env.
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
